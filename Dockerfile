# ============================================================
# Dockerfile - Crynova Backend
# ============================================================
FROM node:18-alpine

# تحديد مجلد العمل داخل الحاوية
WORKDIR /app

# نسخ ملفات الاعتماديات أولاً (للاستفادة من caching)
COPY package*.json ./

# تثبيت الاعتماديات فقط (بدون devDependencies)
RUN npm install --omit=dev

# نسخ باقي ملفات المشروع (هذا السطر مرة واحدة فقط)
COPY . .

# Render يمرر المنفذ تلقائياً عبر متغير PORT، لكننا نحدده للتوثيق
EXPOSE 10000

# تشغيل التطبيق
CMD ["node", "server.js"]
